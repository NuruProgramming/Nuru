{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nuru",
  "scopeName": "source.nuru",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#variables" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.nuru",
          "match": "//.*$"
        },
        {
          "name": "comment.line.number-sign.nuru",
          "match": "#.*$"
        },
        {
          "name": "comment.block.nuru",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.nuru",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.nuru",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.nuru",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.nuru",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.nuru",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.nuru",
          "match": "\\b(kama|au|sivyo|wakati|kwa|katika|vunja|endelea|rudisha|badili|ikiwa|kawaida|jaribu|kamata)\\b"
        },
        {
          "name": "keyword.declaration.nuru",
          "match": "\\b(fanya|unda|tumia|kutoka|jaribio)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.nuru",
          "match": "\\b(kweli|sikweli|tupu)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.nuru",
          "match": "\\b(namba|nukuu|orodha|chaguo|ktk)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.nuru",
          "match": "\\b(andika|jaza|aina|idadi|sukuma|ondoa|fungua|soma|hifadhi|ongeza|futa)\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.nuru",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b(?!\\s*\\()"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.nuru",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.nuru",
          "match": "(==|!=|<=|>=|<|>|=|\\+|-|\\*|/|%|&&|\\|\\||!|\\+=|-=|\\*=|/=)"
        }
      ]
    }
  }
}